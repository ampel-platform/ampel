      width="150"
    />
    <h1>
      Die Anfrage hat zu lange gedauert
    </h1>
    <p
      style="max-width: 600px; width: fit-content; margin: auto;"
    >
      Anfrage zu langsam oder unterbrochen. Die Seite wird in 
      <span
        id="reload-countdown"
      >
        30
      </span>
      <script>
        (function(){
    var end = Date.now() + 30000;
    var span = document.getElementById("reload-countdown");
    if(!span) return;
    
    function tick(){
      var rem = Math.max(0, end - Date.now());
      var sec = Math.ceil(rem / 1000);
      span.textContent = String(sec);
      if(rem &lt;= 0) window.location.reload();
      setTimeout(tick, 250);
    }
    tick();
  })();
      </script>
       Sekunden automatisch neu geladen
    </p>
    <br />
  </div>
</div>
`;

