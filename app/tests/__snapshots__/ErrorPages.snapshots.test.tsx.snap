exports[`error pages snapshots > MaintenanceError 1`] = `
<div>
  <div
    style="text-align: center; padding-top: 4rem;"
  >
    <title>
      LAMPE-CDSS
    </title>
    <meta
      charset="utf-8"
    />
    <img
      alt="UKL Logo"
      src="/assets/UKL_Logo_Vektor.svg"
      width="300"
    />
    <br />
    <img
      alt="Lampe Logo"
      src="/assets/Lampe_Logo_Vektor.svg"
      width="150"
    />
    <h1>
      Wartungsfenster
    </h1>
    <p
      style="max-width: 600px; width: fit-content; margin: auto;"
    >
      Geplante Wartung. Die Anwendung ist vorübergehend nicht verfügbar. Die Seite wird in
       
      <span
        id="reload-countdown"
      >
        300
      </span>
      <script>
        (function(){
    var end = Date.now() + 300000;
    var span = document.getElementById("reload-countdown");
    if(!span) return;
    
    function tick(){
      var rem = Math.max(0, end - Date.now());
      var sec = Math.ceil(rem / 1000);
      span.textContent = String(sec);
      if(rem &lt;= 0) window.location.reload();
      setTimeout(tick, 250);
    }
    tick();
  })();
      </script>
       Sekunden automatisch neu geladen.
    </p>
    <br />
  </div>
</div>
`;

