    <textAnnotation id="sid-4B05CE47-8AB3-40CE-B2F9-0B135A7F3AB6" signavio:alignment="left">
      <extensionElements>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000" />
      </extensionElements>
      <text>From here on, AKI is staged according to 2.1.2 of the guideline</text>
    </textAnnotation>
    <textAnnotation id="sid-C555A9EB-DAAD-4CA6-9A0E-46AB00D18C98" signavio:alignment="left">
      <extensionElements>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000" />
      </extensionElements>
      <text>This question is NOT part of the guideline. It serves to prevent the AKI alarm in patients with a known dialysis requirement, so that unnecessary alarms and alarm fatigue are avoided</text>
    </textAnnotation>
    <textAnnotation id="sid-025CB8F8-8934-40A6-BF76-4CFDB9289A7B" signavio:alignment="left">
